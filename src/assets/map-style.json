{
  "version": 8,
  "name": "Seoul Tycoon Pastel",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f3ef"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood"],
      "paint": {
        "fill-color": "#f0ede8",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "commercial", "retail", "industrial"],
      "paint": {
        "fill-color": "#ede8e3",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "recreation_ground", "playground", "pitch", "golf", "grass", "cemetery", "allotments"],
      "paint": {
        "fill-color": "#d4edda",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "scrub", "wood", "forest"],
      "paint": {
        "fill-color": "#d4edda",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c5e3f6",
        "fill-opacity": 1
      }
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["in", "class", "river", "canal"],
      "paint": {
        "line-color": "#c5e3f6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 4]
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["in", "class", "stream", "ditch", "drain"],
      "paint": {
        "line-color": "#c5e3f6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 2]
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#e0dbd4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 2, 14, 12]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 14, 10]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary"],
      "paint": {
        "line-color": "#e8e4df",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 14, 9]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.8, 14, 7]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-tertiary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "tertiary"],
      "paint": {
        "line-color": "#eeebe6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 14, 7]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "tertiary"],
      "paint": {
        "line-color": "#fafafa",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 5]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "paint": {
        "line-color": "#eeebe6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 4]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "paint": {
        "line-color": "#fafafa",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 16, 3]
      },
      "layout": { "line-join": "round", "line-cap": "round" }
    },
    {
      "id": "building-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#f0eee8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 1]
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#f0eee8",
        "fill-extrusion-height": [
          "interpolate", ["linear"], ["zoom"],
          14, 0,
          16, ["coalesce", ["get", "render_height"], ["get", "height"], 10]
        ],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.7
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 14, 13],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#7ab8d4",
        "text-halo-color": "rgba(255,255,255,0.6)",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 12, 14, 18],
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#999999",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood", "village"],
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 14],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#aaaaaa",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    }
  ]
}
